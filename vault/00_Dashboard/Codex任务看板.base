filters:
  and:
  - '!file.inFolder("_templates")'
  - '!file.inFolder("01_个人空间")'
  - and:
    - type == "codex-session"
properties:
  status:
    displayName: 状态
  domain:
    displayName: 领域
  project:
    displayName: 项目
  source_session:
    displayName: Session
  source_rollout:
    displayName: Rollout
  commit:
    displayName: 提交
  updated:
    displayName: 更新
  next_action:
    displayName: 后续
views:
- type: table
  name: 进行中与待核实
  filters:
    and:
    - '!["done", "completed", "complete", "cancelled", "canceled", "closed", "archived"].contains(status)'
  order:
  - file.name
  - status
  - domain
  - project
  - next_action
- type: table
  name: 最近工作记录
  order:
  - file.name
  - status
  - domain
  - project
  - commit
  - updated
  - next_action
  sort:
  - property: updated
    direction: DESC
  limit: 50
