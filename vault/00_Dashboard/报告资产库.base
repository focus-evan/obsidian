filters:
  and:
  - '!file.inFolder("_templates")'
  - '!file.inFolder("01_个人空间")'
  - and:
    - type == "report-asset"
properties:
  status:
    displayName: 状态
  domain:
    displayName: 领域
  project:
    displayName: 项目
  artifact_path:
    displayName: 产物
  report_date:
    displayName: 日期
  validation:
    displayName: 校验
  publish_status:
    displayName: 发布
  published_url:
    displayName: 线上链接
  content_hash:
    displayName: 内容哈希
  feedback_status:
    displayName: 反馈
  next_action:
    displayName: 后续
views:
- type: table
  name: 全部报告
  order:
  - file.name
  - report_date
  - status
  - domain
  - project
  - artifact_path
  - validation
  - publish_status
  - published_url
  - content_hash
  - feedback_status
  - next_action
  sort:
  - property: report_date
    direction: DESC
  limit: 100
- type: table
  name: 需修复
  filters:
    and:
    - status != "done"
  order:
  - file.name
  - status
  - artifact_path
  - next_action
